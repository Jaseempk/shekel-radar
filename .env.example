# Copy to .env (ignored). The real process environment always wins over this file.
# Only model scoring, personalisation and Reddit drafting need the key; help,
# collection without scoring, export-only rebuilds and `npm test` do not.
ANTHROPIC_API_KEY=

# Optional: keep state, raw data and exports outside this checkout.
# INCOME_DATA_DIR=/absolute/path/to/income-data
# Optional: Chrome/Brave remote-debugging endpoint for the X and Facebook collectors.
# INCOME_CDP_URL=http://127.0.0.1:9222
# Optional: override models from config/settings.json and config/settings.local.json.
# INCOME_SOCIAL_MODEL=claude-haiku-4-5
# INCOME_DRAFT_MODEL=claude-opus-4-8
# Optional: use a different local settings override file (it must exist when set).
# INCOME_SETTINGS_LOCAL=/absolute/path/to/settings.local.json
# SMTP probe identity for `outreach verify`: your own envelope sender and HELO name.
# Read by email-finder/find_emails.py; never borrow someone else's identity.
# INCOME_SMTP_MAIL_FROM=you@example.com
# INCOME_SMTP_HELO=mail.example.com
# Reddit scraping uses the separate niche-radar checkout.
# NICHE_RADAR=/absolute/path/to/niche-radar
